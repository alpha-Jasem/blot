<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="نشرة">
<meta name="theme-color" content="#08090f">
<title>نشرة</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
<style>
/* ════════════════════════════════
   TOKENS
════════════════════════════════ */
:root{
  --bg1:#08090f; --bg2:#0e1018;
  --accent:#63B3FF;
  --accent-glow:rgba(99,179,255,.45);
  --gold:#F5C842; --gold-d:#C8960C;
  --green:#2ECC71; --red:#E74C3C;
  --white:#ffffff;
  --g05:rgba(255,255,255,.05);
  --g08:rgba(255,255,255,.08);
  --g12:rgba(255,255,255,.12);
  --g18:rgba(255,255,255,.18);
  --g30:rgba(255,255,255,.30);
  --gb:rgba(255,255,255,.10);
  --t1:#ffffff; --t2:rgba(255,255,255,.55); --t3:rgba(255,255,255,.28);
  --surf:rgba(14,18,36,.96);
  --ease:cubic-bezier(.22,1,.36,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overflow:hidden;}
body{
  font-family:'Tajawal',sans-serif;
  background:var(--bg1);
  color:var(--t1);
  position:fixed;inset:0;
}

/* ── SCREENS ── */
.screen{position:absolute;inset:0;display:flex;flex-direction:column;
  opacity:0;pointer-events:none;
  transition:opacity .38s var(--ease),transform .38s var(--ease);
  transform:translateY(16px) scale(.99);overflow:hidden;}
.screen.active{opacity:1;pointer-events:all;transform:none;}

/* ════════════════════════════════
   SPLASH
════════════════════════════════ */
#splash{
  background:radial-gradient(ellipse at 30% 20%,#0d0f18 0%,#08090f 70%);
  align-items:center;justify-content:center;z-index:999;
  flex-direction:column;gap:0;
}
/* particles */
#splash::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(1.5px 1.5px at 15% 20%,rgba(255,255,255,.6) 0%,transparent 100%),
    radial-gradient(1px 1px at 72% 12%,rgba(255,255,255,.5) 0%,transparent 100%),
    radial-gradient(1.5px 1.5px at 88% 35%,rgba(255,255,255,.4) 0%,transparent 100%),
    radial-gradient(1px 1px at 40% 8%,rgba(255,255,255,.55) 0%,transparent 100%),
    radial-gradient(1px 1px at 60% 80%,rgba(255,255,255,.35) 0%,transparent 100%),
    radial-gradient(1.5px 1.5px at 25% 70%,rgba(255,255,255,.45) 0%,transparent 100%),
    radial-gradient(1px 1px at 90% 65%,rgba(255,255,255,.4) 0%,transparent 100%),
    radial-gradient(1px 1px at 8% 55%,rgba(255,255,255,.3) 0%,transparent 100%);
}

.splash-icon-wrap{
  width:120px;height:120px;border-radius:32px;
  background:linear-gradient(145deg,rgba(99,179,255,.14),rgba(99,179,255,.03));
  border:1px solid rgba(99,179,255,.2);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 80px rgba(99,179,255,.1),inset 0 1px 0 rgba(255,255,255,.06);
  animation:iconPop .8s var(--spring) .3s both;
  position:relative;overflow:hidden;
}
.splash-icon-wrap::after{
  content:'';position:absolute;
  top:-40px;left:-40px;width:80px;height:80px;
  background:radial-gradient(circle,rgba(79,142,247,.25),transparent 70%);
}
@keyframes iconPop{from{opacity:0;transform:scale(.5) translateY(20px)}to{opacity:1;transform:none}}

.splash-name{
  font-size:42px;font-weight:900;color:#fff;letter-spacing:-2px;
  margin-top:20px;
  animation:fadeUp .7s var(--ease) .55s both;
  text-shadow:0 0 60px rgba(99,179,255,.2);
}
.splash-tag{
  font-size:13px;font-weight:400;color:var(--t3);
  margin-top:6px;letter-spacing:2px;
  animation:fadeUp .6s var(--ease) .7s both;
}
.splash-dots{display:flex;gap:6px;margin-top:28px;animation:fadeUp .5s var(--ease) .9s both;}
.dot{width:5px;height:5px;border-radius:50%;background:var(--g18);animation:dotPulse 1.4s ease-in-out infinite;}
.dot:nth-child(2){animation-delay:.2s}.dot:nth-child(3){animation-delay:.4s}
@keyframes dotPulse{0%,80%,100%{transform:scale(.5);opacity:.3}40%{transform:scale(1);opacity:1}}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* ════════════════════════════════
   GAME SCREEN
════════════════════════════════ */
#game{background:var(--bg1);}

/* Ambient background orbs */
.game-orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(60px);}
.orb1{width:300px;height:300px;background:rgba(99,179,255,.04);top:-100px;right:-80px;}
.orb2{width:250px;height:250px;background:rgba(99,179,255,.025);bottom:200px;left:-80px;}

/* ── TOP BAR ── */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:52px 20px 14px;
  position:relative;z-index:10;flex-shrink:0;
}
.topbar-title{
  position:absolute;left:50%;transform:translateX(-50%);
  font-size:22px;font-weight:900;color:var(--t1);
  letter-spacing:-1px;
  text-shadow:0 0 30px rgba(79,142,247,.2);
}
.topbar-actions{display:flex;gap:8px;}
.icon-btn{
  width:38px;height:38px;border:none;border-radius:12px;
  background:var(--g08);border:1px solid var(--gb);
  color:var(--t2);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(20px);
  transition:all .15s;
}
.icon-btn:active{background:var(--g18);transform:scale(.88);color:var(--t1);}
.icon-btn svg{width:17px;height:17px;}

/* ── SCORE PANELS ── */
.score-zone{
  display:flex;padding:0 16px 14px;gap:10px;flex-shrink:0;
  position:relative;z-index:5;
}
.score-panel{
  flex:1;border-radius:20px;overflow:hidden;position:relative;
  background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.015));
  border:1px solid rgba(255,255,255,.07);
  backdrop-filter:blur(30px);
  padding:18px 14px 16px;
  display:flex;flex-direction:column;align-items:center;gap:10px;
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset,0 20px 40px rgba(0,0,0,.3);
}
.score-panel::before{
  content:'';position:absolute;
  top:-1px;left:10%;right:10%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);
}
.score-panel-name{
  font-size:13px;font-weight:700;color:var(--t3);
  letter-spacing:1.5px;text-transform:uppercase;
}
.score-circle{
  width:100px;height:100px;border-radius:50%;position:relative;
  display:flex;align-items:center;justify-content:center;
}
.score-circle-bg{
  position:absolute;inset:0;border-radius:50%;
  background:conic-gradient(from 0deg,rgba(99,179,255,.1) 0%,rgba(99,179,255,.03) 100%);
  border:1.5px solid rgba(99,179,255,.16);
  box-shadow:inset 0 0 20px rgba(0,0,0,.3);
}
.score-circle::after{
  content:'';position:absolute;inset:6px;border-radius:50%;
  border:1px solid rgba(79,142,247,.1);
}
.score-number{
  font-size:44px;font-weight:900;color:var(--t1);line-height:1;
  position:relative;z-index:1;
  transition:transform .2s var(--spring);
}
.score-number.pop{animation:numPop .35s var(--spring);}
@keyframes numPop{0%{transform:scale(1)}40%{transform:scale(1.3)}100%{transform:scale(1)}}
.score-number.danger{color:var(--gold);text-shadow:0 0 24px rgba(245,200,66,.4);}

/* ── MID SECTION ── */
.mid-section{
  flex:1;display:flex;flex-direction:column;align-items:center;
  background:linear-gradient(180deg,rgba(4,5,10,.0) 0%,rgba(4,5,10,.6) 8%);
  border-radius:28px 28px 0 0;
  border-top:1px solid rgba(255,255,255,.055);
  padding:16px 16px 0;
  position:relative;z-index:5;
  overflow:hidden;
}
.mid-section::before{
  content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:40px;height:4px;border-radius:2px;
  background:var(--g12);margin-top:10px;
}

/* Dealer row */
.dealer-row{display:flex;flex-direction:column;align-items:center;gap:2px;margin-bottom:12px;}
.dealer-label{font-size:10px;font-weight:700;color:var(--t3);letter-spacing:2px;text-transform:uppercase;}
.dealer-name{font-size:15px;font-weight:800;color:var(--t2);}

/* Arrow button */
.arrow-btn{
  width:58px;height:58px;border:none;border-radius:18px;
  background:linear-gradient(145deg,var(--g12),var(--g05));
  border:1px solid var(--gb);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  margin-bottom:14px;
  box-shadow:0 4px 20px rgba(0,0,0,.25),inset 0 1px 0 var(--g12);
  transition:all .15s;position:relative;
}
.arrow-btn::before{
  content:'';position:absolute;inset:0;border-radius:inherit;
  background:linear-gradient(145deg,rgba(79,142,247,.08),transparent);
}
.arrow-btn:active{transform:scale(.88);box-shadow:none;}
.arrow-glyph{
  font-size:24px;color:var(--t1);position:relative;z-index:1;
  transition:transform .38s var(--spring);
}

/* Timer */
.timer-wrap{
  display:flex;align-items:center;gap:8px;
  background:var(--g05);border:1px solid var(--gb);
  border-radius:999px;padding:6px 16px;
  margin-bottom:16px;
}
.timer-text{font-size:19px;font-weight:900;color:var(--t1);font-variant-numeric:tabular-nums;letter-spacing:1.5px;}

/* Register CTA */
.cta-wrap{width:100%;max-width:260px;margin-bottom:18px;position:relative;}
.cta-btn{
  width:100%;background:none;border:none;
  border-radius:999px;padding:0;cursor:pointer;
  position:relative;overflow:hidden;
  transition:transform .15s var(--spring);
}
.cta-btn:active{transform:scale(.95);}
.cta-inner{
  background:linear-gradient(135deg,rgba(99,179,255,.2) 0%,rgba(99,179,255,.1) 100%);
  border:1px solid rgba(99,179,255,.38);
  border-radius:999px;padding:17px 32px;
  font-family:'Tajawal',sans-serif;font-size:20px;font-weight:900;color:var(--t1);
  display:flex;align-items:center;justify-content:center;gap:10px;
  backdrop-filter:blur(20px);
  box-shadow:0 0 30px rgba(99,179,255,.1),inset 0 1px 0 rgba(255,255,255,.08);
  position:relative;
}
.cta-inner::before{
  content:'';position:absolute;top:0;left:0;right:0;height:50%;
  background:linear-gradient(180deg,rgba(255,255,255,.06),transparent);
  border-radius:999px 999px 0 0;
}
.cta-icon{width:20px;height:20px;opacity:.7;}

/* History */
.history-scroll{width:100%;flex:1;overflow-y:auto;padding-bottom:8px;-webkit-overflow-scrolling:touch;}
.history-header{display:flex;padding:0 6px 8px;border-bottom:1px solid var(--g05);margin-bottom:8px;}
.history-col{flex:1;text-align:center;font-size:10px;font-weight:800;color:var(--t3);letter-spacing:.8px;text-transform:uppercase;}
.history-list{display:flex;flex-direction:column;gap:5px;padding:0 2px;}
.history-row{
  display:flex;align-items:center;position:relative;
  background:linear-gradient(90deg,var(--g05),rgba(255,255,255,.03));
  border:1px solid var(--g05);border-radius:12px;
  padding:9px 14px;
  animation:rowSlide .25s var(--ease);
}
@keyframes rowSlide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none}}
.history-val{flex:1;text-align:center;font-size:17px;font-weight:800;color:var(--t2);}
.history-val.win{color:var(--green);text-shadow:0 0 12px rgba(46,204,113,.3);}
.history-val.z{color:var(--t3);font-size:13px;}
.history-sep{width:1px;height:18px;background:var(--g08);}
.history-round{
  position:absolute;top:-7px;left:50%;transform:translateX(-50%);
  background:rgba(6,8,16,.9);border:1px solid var(--g08);
  border-radius:999px;font-size:9px;font-weight:700;color:var(--t3);
  padding:2px 9px;white-space:nowrap;letter-spacing:.5px;
}

/* ── BOTTOM ACTIONS ── */
.bottom-actions{
  display:flex;gap:8px;padding:10px 16px 10px;
  background:rgba(6,8,16,.6);
  border-top:1px solid var(--g05);
  backdrop-filter:blur(30px);
  flex-shrink:0;
}
.action-btn{
  flex:1;border:none;border-radius:999px;padding:12px;
  font-family:'Tajawal',sans-serif;font-size:14px;font-weight:800;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;
  transition:all .15s var(--spring);
  position:relative;overflow:hidden;
}
.action-btn:active{transform:scale(.95);}
.action-btn::before{
  content:'';position:absolute;top:0;left:0;right:0;height:50%;
  background:linear-gradient(180deg,rgba(255,255,255,.06),transparent);
}
.btn-undo{
  background:linear-gradient(135deg,rgba(231,76,60,.25),rgba(192,57,43,.15));
  border:1px solid rgba(231,76,60,.35);color:#E74C3C;
}
.btn-new{
  background:linear-gradient(135deg,rgba(46,204,113,.25),rgba(30,140,70,.15));
  border:1px solid rgba(46,204,113,.35);color:#2ECC71;
}

/* ── BOTTOM NAV ── */
.bottom-nav{
  display:flex;align-items:center;
  margin:0 16px 32px;
  background:rgba(4,5,12,.8);
  border:1px solid rgba(255,255,255,.07);border-radius:22px;
  padding:8px 6px;
  backdrop-filter:blur(50px) saturate(180%);
  -webkit-backdrop-filter:blur(50px) saturate(180%);
  box-shadow:0 8px 32px rgba(0,0,0,.5),inset 0 1px 0 var(--g08);
  flex-shrink:0;position:relative;overflow:hidden;
}
.bottom-nav::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,var(--g05),transparent);pointer-events:none;
}
.nav-tab{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;
  background:none;border:none;cursor:pointer;
  padding:7px 4px;border-radius:16px;
  transition:all .2s;position:relative;z-index:1;
  -webkit-user-select:none;user-select:none;
}
.nav-tab:active{background:var(--g08);}
.nav-tab svg{
  width:22px;height:22px;
  transition:transform .28s var(--spring),opacity .2s,filter .2s;
}
.nav-tab .nav-label{
  font-size:10px;font-weight:800;color:var(--t3);
  letter-spacing:.4px;transition:color .2s;
}
.nav-tab.active .nav-label{color:var(--accent);}
.nav-tab.active svg{
  opacity:1;transform:scale(1.12);
  filter:drop-shadow(0 0 8px var(--accent-glow));
}
.nav-tab:not(.active) svg{opacity:.7;}
.nav-tab.active::before{
  content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:32px;height:3px;border-radius:0 0 3px 3px;
  background:var(--accent);
  box-shadow:0 0 18px 3px var(--accent-glow);
}

/* ════════════════════════════════
   SHEETS & OVERLAYS
════════════════════════════════ */
.overlay{
  display:none;position:fixed;inset:0;z-index:200;
  background:rgba(0,0,0,.6);backdrop-filter:blur(10px);
  align-items:flex-end;justify-content:center;
}
.overlay.show{display:flex;}

.bottom-sheet{
  background:var(--surf);
  border:1px solid var(--gb);
  border-radius:28px 28px 0 0;width:100%;
  padding:12px 20px 48px;
  backdrop-filter:blur(50px);
  box-shadow:0 -12px 60px rgba(0,0,0,.5),inset 0 1px 0 var(--g12);
  animation:sheetUp .32s var(--ease);
}
@keyframes sheetUp{from{transform:translateY(100%);opacity:.8}to{transform:none;opacity:1}}
.sheet-handle{width:36px;height:4px;border-radius:2px;background:var(--g18);margin:0 auto 16px;}
.sheet-title{font-size:17px;font-weight:800;color:var(--t1);text-align:center;margin-bottom:20px;letter-spacing:-.3px;}

/* Score inputs */
.score-inputs{display:flex;gap:12px;align-items:center;margin-bottom:14px;}
.score-input-group{flex:1;display:flex;flex-direction:column;gap:7px;align-items:center;}
.score-input-label{font-size:11px;font-weight:800;color:var(--t3);letter-spacing:1px;text-transform:uppercase;}
.score-input{
  width:100%;text-align:center;
  font-family:'Tajawal',sans-serif;font-size:42px;font-weight:900;color:var(--t1);
  background:var(--g08);border:1.5px solid var(--gb);
  border-radius:18px;padding:14px 8px;outline:none;
  -webkit-appearance:none;appearance:none;
  transition:border-color .2s,background .2s,transform .2s var(--spring);
}
.score-input:focus{
  border-color:rgba(79,142,247,.6);
  background:rgba(79,142,247,.08);
  transform:scale(1.02);
}
.score-input::-webkit-outer-spin-button,
.score-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
.score-dash{font-size:20px;color:var(--t3);padding-top:24px;}

.sheet-hint{
  background:var(--g05);border:1px solid var(--gb);
  border-radius:12px;padding:8px 14px;
  font-size:13px;color:var(--accent);font-weight:700;
  text-align:center;margin-bottom:14px;min-height:30px;
  letter-spacing:.2px;
}
.sheet-hint.err{color:var(--red);background:rgba(231,76,60,.07);border-color:rgba(231,76,60,.2);}

.sheet-submit{
  width:100%;border:none;border-radius:16px;padding:16px;
  font-family:'Tajawal',sans-serif;font-size:18px;font-weight:900;
  cursor:pointer;letter-spacing:-.3px;
  background:linear-gradient(135deg,rgba(79,142,247,.35),rgba(45,92,232,.25));
  border:1px solid rgba(79,142,247,.5);color:white;
  box-shadow:0 4px 24px rgba(79,142,247,.25),inset 0 1px 0 rgba(255,255,255,.1);
  transition:transform .15s var(--spring),opacity .15s;
  position:relative;overflow:hidden;
}
.sheet-submit::before{content:'';position:absolute;top:0;left:0;right:0;height:50%;background:linear-gradient(180deg,rgba(255,255,255,.08),transparent);}
.sheet-submit:active{transform:scale(.97);opacity:.9;}

/* Win sheet */
.win-overlay{
  display:none;position:fixed;inset:0;z-index:250;
  background:rgba(0,0,0,.7);backdrop-filter:blur(16px);
  align-items:flex-end;justify-content:center;
}
.win-overlay.show{display:flex;}
.win-sheet{
  background:var(--surf);border:1px solid var(--gb);
  border-radius:28px 28px 0 0;width:100%;
  padding:12px 24px 52px;
  display:flex;flex-direction:column;align-items:center;gap:8px;
  box-shadow:0 -12px 60px rgba(0,0,0,.6),inset 0 1px 0 var(--g12);
  animation:sheetUp .42s var(--spring);
}
.win-trophy{
  width:72px;height:72px;border-radius:22px;
  background:linear-gradient(135deg,rgba(245,200,66,.2),rgba(200,150,12,.1));
  border:1px solid rgba(245,200,66,.3);
  display:flex;align-items:center;justify-content:center;
  margin-top:8px;
  box-shadow:0 0 40px rgba(245,200,66,.12);
  animation:trophyBounce .6s var(--spring) .1s both;
}
@keyframes trophyBounce{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
.win-label{font-size:12px;color:var(--t3);font-weight:700;letter-spacing:1px;text-transform:uppercase;}
.win-name{font-size:32px;font-weight:900;color:var(--t1);letter-spacing:-1px;}
.win-score{font-size:13px;color:var(--t3);margin-bottom:8px;}
.win-btns{display:flex;gap:10px;width:100%;margin-top:4px;}
.win-btn{
  flex:1;border:none;border-radius:999px;padding:14px;
  font-family:'Tajawal',sans-serif;font-size:15px;font-weight:800;
  cursor:pointer;transition:transform .15s var(--spring);
}
.win-btn:active{transform:scale(.96);}
.win-btn-new{
  background:linear-gradient(135deg,rgba(79,142,247,.35),rgba(45,92,232,.25));
  border:1px solid rgba(79,142,247,.5);color:white;
}
.win-btn-undo{background:var(--g08);color:var(--t2);border:1px solid var(--gb);}

/* Confirm modal */
.modal-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.7);backdrop-filter:blur(14px);
  z-index:300;align-items:center;justify-content:center;padding:32px;
}
.modal-overlay.show{display:flex;}
.modal-card{
  background:var(--surf);border:1px solid var(--gb);
  border-radius:24px;padding:28px 22px;text-align:center;
  width:100%;max-width:300px;
  box-shadow:0 24px 80px rgba(0,0,0,.6);
  animation:modalPop .3s var(--spring);
}
@keyframes modalPop{from{transform:scale(.82);opacity:0}to{transform:none;opacity:1}}
.modal-icon{width:52px;height:52px;border-radius:16px;background:var(--g08);border:1px solid var(--gb);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;}
.modal-title{font-size:19px;font-weight:900;color:var(--t1);margin-bottom:5px;letter-spacing:-.3px;}
.modal-sub{font-size:13px;color:var(--t2);margin-bottom:22px;line-height:1.6;}
.modal-btns{display:flex;gap:8px;}
.modal-btn{
  flex:1;border:none;border-radius:12px;padding:13px;
  font-family:'Tajawal',sans-serif;font-size:14px;font-weight:800;
  cursor:pointer;transition:transform .12s;
}
.modal-btn:active{transform:scale(.96);}
.modal-cancel{background:var(--g08);color:var(--t2);border:1px solid var(--gb);}
.modal-ok{background:rgba(231,76,60,.22);color:#FF6B5B;border:1px solid rgba(231,76,60,.3);}

/* ════════════════════════════════
   EDIT NAMES
════════════════════════════════ */
#editNames{background:var(--bg1);}
.edit-scroll{flex:1;overflow-y:auto;padding:16px;}
.edit-group{margin-bottom:24px;}
.edit-group-label{font-size:10px;font-weight:800;color:var(--t3);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;padding-right:2px;}
.edit-field{
  width:100%;font-family:'Tajawal',sans-serif;
  font-size:16px;font-weight:700;color:var(--t1);
  background:var(--g08);border:1.5px solid var(--gb);
  border-radius:14px;padding:14px 16px;
  outline:none;margin-bottom:8px;text-align:right;
  transition:border-color .2s,background .2s;
}
.edit-field:focus{border-color:rgba(79,142,247,.5);background:rgba(79,142,247,.07);}
.edit-field::placeholder{color:var(--t3);font-weight:400;}
.edit-footer{padding:12px 16px 40px;display:flex;gap:10px;border-top:1px solid var(--g05);background:rgba(6,8,16,.5);}
.edit-btn{
  flex:1;border:none;border-radius:16px;padding:15px;
  font-family:'Tajawal',sans-serif;font-size:15px;font-weight:800;
  cursor:pointer;transition:transform .12s;
}
.edit-btn:active{transform:scale(.97);}
.edit-skip{background:var(--g08);color:var(--t2);border:1px solid var(--gb);}
.edit-done{
  background:linear-gradient(135deg,rgba(79,142,247,.35),rgba(45,92,232,.25));
  border:1px solid rgba(79,142,247,.5);color:white;
}

/* ════════════════════════════════
   THEME PICKER
════════════════════════════════ */
#themePicker{background:var(--bg1);}
.theme-body{flex:1;overflow-y:auto;padding:14px;}
.theme-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.theme-featured{grid-column:1/-1;}
.theme-item{border-radius:20px;overflow:hidden;cursor:pointer;border:2px solid rgba(255,255,255,.06);transition:border-color .2s,transform .15s;}
.theme-item:active{transform:scale(.98);}
.theme-item.sel{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent);}
.theme-preview{position:relative;width:100%;aspect-ratio:3/4;overflow:hidden;}
.theme-featured .theme-preview{aspect-ratio:16/9;}
.theme-scores{position:absolute;bottom:0;left:0;right:0;display:flex;gap:8px;padding:10px 14px;background:linear-gradient(to top,rgba(0,0,0,.6),transparent);}
.ts{flex:1;text-align:center;}
.ts-n{font-size:9px;font-weight:800;color:var(--ts-color,rgba(99,179,255,.5));letter-spacing:1.5px;text-transform:uppercase;}
.ts-v{font-size:28px;font-weight:900;color:white;line-height:1.1;}
.theme-info{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,.03);border-top:1px solid rgba(255,255,255,.06);}
.theme-name{font-size:14px;font-weight:800;color:var(--t1);letter-spacing:-.2px;}
.theme-check-ico{width:24px;height:24px;border-radius:50%;background:var(--accent);display:none;align-items:center;justify-content:center;}
.theme-item.sel .theme-check-ico{display:flex;}
.theme-section-label{font-size:10px;font-weight:800;color:var(--t3);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;margin-top:6px;}
.art-cards-row{display:flex;gap:12px;margin-bottom:20px;}
.art-card{
  flex:1;border-radius:18px;overflow:hidden;cursor:pointer;
  border:2px solid transparent;aspect-ratio:200/280;position:relative;
  box-shadow:0 8px 32px rgba(0,0,0,.5);
  transition:transform .15s,border-color .2s;
}
.art-card:active{transform:scale(.96);}
.art-card.sel{border-color:var(--accent);box-shadow:0 8px 40px rgba(79,142,247,.3);}
.art-svg{width:100%;height:100%;display:block;}
.art-check{
  position:absolute;top:10px;left:10px;width:24px;height:24px;
  border-radius:50%;background:var(--accent);display:none;align-items:center;justify-content:center;
  box-shadow:0 0 12px var(--accent-glow);
}
.art-card.sel .art-check{display:flex;}
.art-card-name{
  position:absolute;bottom:0;right:0;left:0;
  padding:24px 10px 10px;
  background:linear-gradient(to top,rgba(0,0,0,.75),transparent);
  text-align:center;font-size:12px;font-weight:800;color:white;
}
.color-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;}
.color-swatch{
  border-radius:14px;aspect-ratio:1;cursor:pointer;position:relative;overflow:hidden;
  border:2px solid transparent;transition:transform .14s,border-color .18s;
  box-shadow:0 4px 16px rgba(0,0,0,.35);
}
.color-swatch:active{transform:scale(.94);}
.color-swatch.sel{border-color:var(--accent);}
.swatch-bg{position:absolute;inset:0;}
.swatch-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.45),transparent 50%);}
.swatch-check{position:absolute;top:4px;left:4px;width:14px;height:14px;border-radius:50%;background:var(--accent);display:none;align-items:center;justify-content:center;}
.color-swatch.sel .swatch-check{display:flex;}
.swatch-name{position:absolute;bottom:5px;right:0;left:0;text-align:center;font-size:9px;font-weight:800;color:white;text-shadow:0 1px 4px rgba(0,0,0,.6);}

/* ════════════════════════════════
   STATS
════════════════════════════════ */
#statsScreen{background:var(--bg1);}
.stats-body{flex:1;overflow-y:auto;padding:14px;}
.stats-hero{
  background:linear-gradient(145deg,var(--g08),var(--g05));
  border:1px solid var(--gb);border-radius:20px;
  padding:20px;display:flex;flex-direction:column;align-items:center;
  margin-bottom:14px;
  box-shadow:inset 0 1px 0 var(--g08);
}
.stats-hero-icon{
  width:58px;height:58px;border-radius:18px;
  background:linear-gradient(135deg,rgba(79,142,247,.2),rgba(45,92,232,.1));
  border:1px solid rgba(79,142,247,.25);
  display:flex;align-items:center;justify-content:center;margin-bottom:12px;
}
.stats-title{font-size:22px;font-weight:900;color:var(--t1);letter-spacing:-.5px;margin-bottom:3px;}
.stats-sub{font-size:12px;color:var(--t3);font-weight:500;}
.team-toggle{
  display:flex;background:rgba(0,0,0,.3);border:1px solid var(--gb);
  border-radius:999px;padding:3px;margin:14px 0 0;
}
.team-btn{
  flex:1;padding:8px 16px;border:none;border-radius:999px;
  font-family:'Tajawal',sans-serif;font-size:13px;font-weight:800;
  cursor:pointer;color:var(--t3);background:transparent;
  transition:all .22s var(--ease);
}
.team-btn.active{
  background:linear-gradient(135deg,rgba(79,142,247,.3),rgba(45,92,232,.2));
  border:1px solid rgba(79,142,247,.4);color:white;
  box-shadow:0 2px 12px rgba(79,142,247,.25);
}
.stat-cards{display:flex;flex-direction:column;gap:10px;margin-bottom:14px;}
.stat-card{
  background:linear-gradient(145deg,var(--g08),var(--g05));
  border:1px solid var(--gb);border-radius:16px;padding:14px 16px;
  box-shadow:inset 0 1px 0 var(--g08);
}
.stat-card-top{display:flex;align-items:center;gap:12px;margin-bottom:10px;}
.stat-dot{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.stat-dot.g{background:rgba(46,204,113,.18);border:1px solid rgba(46,204,113,.3);}
.stat-dot.r{background:rgba(231,76,60,.18);border:1px solid rgba(231,76,60,.28);}
.stat-dot.b{background:rgba(79,142,247,.18);border:1px solid rgba(79,142,247,.26);}
.stat-num{font-size:24px;font-weight:900;color:var(--t1);}
.stat-lbl{font-size:10px;color:var(--t3);font-weight:700;letter-spacing:.5px;text-transform:uppercase;}
.stat-bar-bg{width:100%;height:4px;background:var(--g08);border-radius:2px;overflow:hidden;}
.stat-bar{height:100%;border-radius:2px;transition:width .8s var(--ease);}
.bar-g{background:linear-gradient(90deg,#2ECC71,#27AE60);}
.bar-r{background:linear-gradient(90deg,#E74C3C,#C0392B);}
.bar-b{background:var(--g18);}
.level-card{
  background:linear-gradient(145deg,var(--g08),var(--g05));
  border:1px solid var(--gb);border-radius:16px;
  padding:16px;display:flex;align-items:center;gap:16px;
  margin-bottom:12px;box-shadow:inset 0 1px 0 var(--g08);
}
.level-ring{position:relative;width:68px;height:68px;flex-shrink:0;}
.level-ring svg{position:absolute;inset:0;width:100%;height:100%;}
.level-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;color:var(--t1);}
.level-title-lbl{font-size:10px;color:var(--t3);font-weight:700;letter-spacing:1px;text-transform:uppercase;}
.level-rank{font-size:21px;font-weight:900;color:var(--t1);letter-spacing:-.5px;}
.level-pcts{display:flex;gap:4px;align-items:center;font-size:12px;}
.pct-g{color:var(--green);font-weight:800;}
.pct-r{color:var(--red);font-weight:800;}
.pct-sep{color:var(--t3);}
.stats-reset-btn{
  width:100%;background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.18);
  border-radius:12px;padding:11px;
  font-family:'Tajawal',sans-serif;font-size:12px;font-weight:700;
  color:rgba(231,76,60,.6);cursor:pointer;
}

/* ════════════════════════════════
   CONTACT
════════════════════════════════ */
#contactScreen{background:var(--bg1);}
.contact-body{flex:1;overflow-y:auto;padding:14px;}
.contact-hero{
  background:linear-gradient(145deg,var(--g08),var(--g05));
  border:1px solid var(--gb);border-radius:20px;
  padding:20px;display:flex;flex-direction:column;align-items:center;
  margin-bottom:14px;box-shadow:inset 0 1px 0 var(--g08);
}
.contact-hero-icon{
  width:58px;height:58px;border-radius:18px;
  background:linear-gradient(135deg,rgba(46,204,113,.18),rgba(30,130,50,.1));
  border:1px solid rgba(46,204,113,.22);
  display:flex;align-items:center;justify-content:center;margin-bottom:12px;
}
.contact-links{display:flex;flex-direction:column;gap:8px;margin-bottom:20px;}
.contact-link{
  display:flex;align-items:center;gap:12px;
  background:linear-gradient(145deg,var(--g08),var(--g05));
  border:1px solid var(--gb);border-radius:16px;
  padding:14px 16px;text-decoration:none;
  transition:background .15s;box-shadow:inset 0 1px 0 var(--g08);
}
.contact-link:active{background:var(--g12);}
.contact-link-icon{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.contact-link-text{flex:1;}
.contact-link-name{font-size:14px;font-weight:800;color:var(--t1);}
.contact-link-handle{font-size:11px;color:var(--t3);font-weight:500;}
.contact-link-arrow{color:var(--t3);}
.contact-version{font-size:11px;color:var(--t3);text-align:center;letter-spacing:.3px;}
</style>
</head>
<body>

<!-- ════ SPLASH ════ -->
<div id="splash" class="screen active">
  <div class="splash-icon-wrap">
    <svg width="70" height="70" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="siBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#141928"/><stop offset="100%" stop-color="#060810"/></linearGradient>
        <linearGradient id="siGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#FFE566"/><stop offset="100%" stop-color="#C8960C"/></linearGradient>
      </defs>
      <rect width="200" height="200" rx="44" fill="url(#siBg)"/>
      <rect x="4" y="4" width="192" height="192" rx="41" fill="none" stroke="rgba(255,215,0,.25)" stroke-width="1.5"/>
      <g transform="rotate(-26 100 180)"><rect x="30" y="60" width="55" height="78" rx="8" fill="white" opacity=".82"/><text x="57" y="115" font-size="36" text-anchor="middle" font-family="serif" fill="#111">♣</text></g>
      <g transform="rotate(-9 100 180)"><rect x="45" y="52" width="55" height="78" rx="8" fill="white" opacity=".92"/><text x="72" y="107" font-size="36" text-anchor="middle" font-family="serif" fill="#cc0000">♦</text></g>
      <g transform="rotate(9 100 180)"><rect x="60" y="52" width="55" height="78" rx="8" fill="white" opacity=".92"/><text x="87" y="107" font-size="36" text-anchor="middle" font-family="serif" fill="#cc0000">♥</text></g>
      <g transform="rotate(26 100 180)"><rect x="75" y="60" width="55" height="78" rx="8" fill="white" opacity=".82"/><text x="102" y="115" font-size="36" text-anchor="middle" font-family="serif" fill="#111">♠</text></g>
      <polygon points="100,156 106,166 100,176 94,166" fill="url(#siGold)" opacity=".9"/>
    </svg>
  </div>
  <div class="splash-name">نشرة</div>
  <div class="splash-tag">احسب · انشر · لحم جديد</div>
  <div class="splash-dots">
    <div class="dot"></div><div class="dot"></div><div class="dot"></div>
  </div>
</div>

<!-- ════ GAME ════ -->
<div id="game" class="screen">
  <div class="game-orb orb1"></div>
  <div class="game-orb orb2"></div>

  <div class="topbar">
    <div class="topbar-actions" style="order:2">
      <button class="icon-btn" onclick="showS('editNames')">
        <svg width="17" height="17" viewBox="0 0 60 80" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="56" height="76" rx="6" fill="white" opacity=".95"/>
          <polygon points="30,8 22,22 30,18 38,22" fill="#8B2BE2" opacity=".9"/>
          <circle cx="22" cy="22" r="3" fill="#FFD700"/>
          <circle cx="38" cy="22" r="3" fill="#E2342B"/>
          <ellipse cx="30" cy="42" rx="12" ry="14" fill="#FFE0A0"/>
          <ellipse cx="26" cy="40" rx="2" ry="2.5" fill="#111"/>
          <ellipse cx="34" cy="40" rx="2" ry="2.5" fill="#111"/>
          <path d="M24,50 Q30,55 36,50" fill="none" stroke="#c00" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M15,60 Q30,55 45,60 L45,78 L15,78 Z" fill="#E2342B" opacity=".3"/>
        </svg>
      </button>
      <button class="icon-btn" onclick="showS('themePicker')">
        <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c1.1 0 2-.9 2-2 0-.51-.19-.98-.5-1.35-.3-.36-.5-.82-.5-1.32 0-1.1.9-2 2-2h2.35C20.37 15.33 22 13.29 22 11c0-4.96-4.48-9-10-9z"
            fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="6.5" cy="11.5" r="1.3" fill="#E2342B"/>
          <circle cx="9.5" cy="7.5" r="1.3" fill="#FFD700"/>
          <circle cx="14.5" cy="7.5" r="1.3" fill="#2ECC71"/>
          <circle cx="17.5" cy="11.5" r="1.3" fill="#4A7BF7"/>
        </svg>
      </button>

    </div>
    <div class="topbar-title">نشرة</div>
    <div style="width:122px;order:1"></div>
  </div>

  <div class="score-zone">
    <div class="score-panel">
      <div class="score-panel-name" id="dispName1">لنا</div>
      <div class="score-circle">
        <div class="score-circle-bg"></div>
        <div class="score-number" id="total1">0</div>
      </div>
    </div>
    <div style="width:1px;background:linear-gradient(to bottom,transparent,var(--gb),transparent);margin:20px 0;flex-shrink:0;"></div>
    <div class="score-panel">
      <div class="score-panel-name" id="dispName2">لهم</div>
      <div class="score-circle">
        <div class="score-circle-bg"></div>
        <div class="score-number" id="total2">0</div>
      </div>
    </div>
  </div>

  <div class="mid-section">
    <div class="dealer-row">
      <div class="dealer-label">توزيع الورق</div>
      <div class="dealer-name" id="dealerName">لنا</div>
    </div>

    <button class="arrow-btn" onclick="manualRotate()">
      <span class="arrow-glyph" id="dealerArrow">↑</span>
    </button>

    <div class="timer-wrap">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--t3)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span class="timer-text" id="timerDisplay">00:00</span>
    </div>

    <div class="cta-wrap">
      <button class="cta-btn" onclick="openSheet()">
        <div class="cta-inner">
          <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          سجّل الجولة
        </div>
      </button>
    </div>

    <div class="history-scroll">
      <div class="history-header">
        <div class="history-col" id="histLabel1">لنا</div>
        <div style="width:28px"></div>
        <div class="history-col" id="histLabel2">لهم</div>
      </div>
      <div class="history-list" id="histList"></div>
    </div>
  </div>

  <div class="bottom-actions">
    <button class="action-btn btn-undo" onclick="undoRound()">تراجع</button>
    <button class="action-btn btn-new" onclick="confirmNew()">نشرة جديدة</button>
  </div>

  <div class="bottom-nav">
    <button class="nav-tab active" onclick="navTab('game')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
      <span class="nav-label">العب</span>
    </button>
    <button class="nav-tab" onclick="navTab('statsScreen')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      <span class="nav-label">إحصائيات</span>
    </button>
    <button class="nav-tab" onclick="navTab('contactScreen')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span class="nav-label">تواصل</span>
    </button>
  </div>
</div>

<!-- ════ EDIT NAMES ════ -->
<div id="editNames" class="screen">
  <div class="topbar">
    <div class="topbar-title">دق الولد</div>
    <div class="topbar-actions">
      <button class="icon-btn" onclick="navTab('game')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div class="edit-scroll">
    <div class="edit-group">
      <div class="edit-group-label">أسماء الفريقين</div>
      <input class="edit-field" id="editTeam1" placeholder="الفريق الأول" value="لنا">
      <input class="edit-field" id="editTeam2" placeholder="الفريق الثاني" value="لهم">
    </div>
    <div class="edit-group">
      <div class="edit-group-label">أسماء اللاعبين</div>
      <input class="edit-field" id="p1" placeholder="اللاعب الأول">
      <input class="edit-field" id="p2" placeholder="اللاعب الثاني">
      <input class="edit-field" id="p3" placeholder="اللاعب الثالث">
      <input class="edit-field" id="p4" placeholder="اللاعب الرابع">
    </div>
  </div>
  <div class="edit-footer">
    <button class="edit-btn edit-skip" onclick="navTab('game')">تخطي</button>
    <button class="edit-btn edit-done" onclick="applyEdit()">تم ✓</button>
  </div>
</div>

<!-- ════ THEME PICKER ════ -->
<div id="themePicker" class="screen">
  <div class="topbar">
    <div class="topbar-title">الثيمات</div>
    <div class="topbar-actions">
      <button class="icon-btn" onclick="navTab('game')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
