    <div class="modal-title">نشرة جديدة؟</div>
    <div class="modal-sub">سيتم مسح جميع النقاط الحالية وبدء لعبة جديدة</div>
    <div class="modal-btns">
      <button class="modal-btn modal-cancel" onclick="closeConfirm()">إلغاء</button>
      <button class="modal-btn modal-ok" onclick="doNew()">تأكيد</button>
    </div>
  </div>
</div>

<!-- ════ STATS RESET CONFIRM ════ -->
<div class="modal-overlay" id="statsResetOv">
  <div class="modal-card">
    <div class="modal-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(231,76,60,.8)" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></div>
    <div class="modal-title">مسح الإحصائيات؟</div>
    <div class="modal-sub">سيتم حذف جميع سجلات الفوز والخسارة</div>
    <div class="modal-btns">
      <button class="modal-btn modal-cancel" onclick="document.getElementById('statsResetOv').classList.remove('show')">إلغاء</button>
      <button class="modal-btn modal-ok" onclick="doResetStats()">تأكيد</button>
    </div>
  </div>
</div>

<script>
/* ═══ STATE ═══ */
let scores=[0,0],history=[],gameOver=false,dealerIdx=0,arrowIdx=0,timerSec=0,timerInt=null,statsTeam=0,isDark=true;
const WIN=152,ARROWS=['↑','←','↓','→'];
const ART_THEMES={art1:{a:'#060810',b:'#0c0f1e',light:false},art2:{a:'#1a0800',b:'#0e0500',light:false}};

/* ═══ SPLASH ═══ */
window.addEventListener('DOMContentLoaded',()=>{
  try{if(localStorage.getItem('nashrah_dark')==='0'){isDark=false;document.body.classList.add('light');updateDmIcon();}}catch(e){}
  setTimeout(()=>{
    const s=document.getElementById('splash');
    s.style.transition='opacity .55s ease,transform .55s ease';
    s.style.opacity='0';s.style.transform='scale(1.06)';
    setTimeout(()=>{s.classList.remove('active');navTab('game');},540);
  },2000);
});

/* ═══ NAV ═══ */
function showS(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}
function navTab(id){
  showS(id);
  if(id==='statsScreen'){statsTeam=0;renderStats();}
  document.querySelectorAll('.nav-tab').forEach(t=>{const f=t.getAttribute('onclick')||'';t.classList.toggle('active',f.includes("'"+id+"'"));});
}

/* ═══ NAMES ═══ */
function getName(i){return document.getElementById(i===0?'dispName1':'dispName2').textContent;}
function applyNames(t1,t2){
  ['dispName1','histLabel1','sheetLbl1','togT1'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=t1;});
  ['dispName2','histLabel2','sheetLbl2','togT2'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=t2;});
  updateDealer();
}
function applyEdit(){applyNames(document.getElementById('editTeam1').value.trim()||'لنا',document.getElementById('editTeam2').value.trim()||'لهم');navTab('game');}

/* ═══ DARK MODE ═══ */
function toggleDark(){isDark=!isDark;document.body.classList.toggle('light',!isDark);try{localStorage.setItem('nashrah_dark',isDark?'1':'0');}catch(e){}updateDmIcon();}
function updateDmIcon(){const i=document.getElementById('dmIcon');if(!i)return;i.innerHTML=isDark?'<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>':'<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';}

/* ═══ THEME ═══ */
function setTheme(card,c1,c2,fl){
  document.querySelectorAll('.color-swatch,.art-card').forEach(c=>c.classList.remove('sel'));
  card.classList.add('sel');
  document.documentElement.style.setProperty('--bg1',c1);document.documentElement.style.setProperty('--bg2',c2);
  document.body.style.background=c1;
  if(fl===true){isDark=false;document.body.classList.add('light');}
  else if(fl===false){isDark=true;document.body.classList.remove('light');}
  try{localStorage.setItem('nashrah_dark',isDark?'1':'0');}catch(e){}
  updateDmIcon();setTimeout(()=>navTab('game'),180);
}
function setArtTheme(id){
  document.querySelectorAll('.color-swatch,.art-card').forEach(c=>c.classList.remove('sel'));
  document.getElementById(id==='art1'?'artCard1':'artCard2').classList.add('sel');
  const t=ART_THEMES[id];
  document.documentElement.style.setProperty('--bg1',t.a);document.documentElement.style.setProperty('--bg2',t.b);
  document.body.style.background=t.a;
  isDark=!t.light;document.body.classList.toggle('light',t.light);
  try{localStorage.setItem('nashrah_dark',isDark?'1':'0');}catch(e){}
  updateDmIcon();setTimeout(()=>navTab('game'),200);
}

/* ═══ TIMER ═══ */
function startTimer(){clearInterval(timerInt);timerSec=0;tick();timerInt=setInterval(tick,1000);}
function stopTimer(){clearInterval(timerInt);}
function tick(){const m=String(Math.floor(timerSec/60)).padStart(2,'0'),s=String(timerSec%60).padStart(2,'0');document.getElementById('timerDisplay').textContent=m+':'+s;timerSec++;}

/* ═══ DEALER ═══ */
function updateDealer(){document.getElementById('dealerName').textContent=getName(dealerIdx);}
function updateArrow(){const e=document.getElementById('dealerArrow');e.textContent=ARROWS[arrowIdx];e.style.transform='scale(1.7) rotate(15deg)';setTimeout(()=>{e.style.transform='';},350);}
function rotateDealer(){dealerIdx=dealerIdx===0?1:0;arrowIdx=(arrowIdx+1)%4;updateDealer();updateArrow();}
function manualRotate(){dealerIdx=dealerIdx===0?1:0;arrowIdx=(arrowIdx+1)%4;updateDealer();updateArrow();}

/* ═══ SHEET ═══ */
function openSheet(){if(gameOver)return;document.getElementById('sIn1').value='';document.getElementById('sIn2').value='';const h=document.getElementById('sheetHint');h.textContent='أدخل نقاط الفريقين';h.className='sheet-hint';document.getElementById('sheetOv').classList.add('show');setTimeout(()=>document.getElementById('sIn1').focus(),100);}
function closeSheet(){document.getElementById('sheetOv').classList.remove('show');}
function closeSheetOut(e){if(e.target===document.getElementById('sheetOv'))closeSheet();}
function onInput(){const s1=parseInt(document.getElementById('sIn1').value)||0,s2=parseInt(document.getElementById('sIn2').value)||0;const h=document.getElementById('sheetHint');h.textContent=(s1||s2)?getName(0)+': +'+s1+' · '+getName(1)+': +'+s2:'أدخل نقاط الفريقين';h.className='sheet-hint';}

/* ═══ REGISTER ═══ */
function registerRound(){
  const v1=document.getElementById('sIn1').value.trim(),v2=document.getElementById('sIn2').value.trim();
  const h=document.getElementById('sheetHint');
  if(!v1||!v2){h.textContent='يجب إدخال نقاط الفريقين';h.className='sheet-hint err';[document.getElementById('sIn1'),document.getElementById('sIn2')].forEach(el=>{if(!el.value.trim()){el.style.borderColor='rgba(231,76,60,.55)';setTimeout(()=>{el.style.borderColor='';},1200);}});return;}
  const s1=parseInt(v1)||0,s2=parseInt(v2)||0;
  history.unshift({add1:s1,add2:s2,snap:[...scores]});scores[0]+=s1;scores[1]+=s2;
  closeSheet();rotateDealer();startTimer();updateDisplay();renderHistory();checkWin();
}

/* ═══ WIN ═══ */
function checkWin(){if(scores[0]>=WIN||scores[1]>=WIN){const wi=scores[0]>=WIN?0:1;gameOver=true;stopTimer();recordWin(wi);document.getElementById('winName').textContent=getName(wi);document.getElementById('winScore').textContent='وصل '+scores[wi]+' نقطة 🎉';document.getElementById('winOv').classList.add('show');}}
function undoFromWin(){document.getElementById('winOv').classList.remove('show');undoRound();}
function newFromWin(){document.getElementById('winOv').classList.remove('show');resetGame();}

/* ═══ UNDO ═══ */
function undoRound(){if(!history.length)return;const last=history.shift();scores=[...last.snap];gameOver=false;dealerIdx=dealerIdx===0?1:0;arrowIdx=(arrowIdx+3)%4;updateDealer();updateArrow();updateDisplay();renderHistory();startTimer();}

/* ═══ NEW ═══ */
function confirmNew(){document.getElementById('confirmOv').classList.add('show');}
function closeConfirm(){document.getElementById('confirmOv').classList.remove('show');}
function doNew(){closeConfirm();resetGame();}
function resetGame(){scores=[0,0];history=[];gameOver=false;dealerIdx=0;arrowIdx=0;stopTimer();timerSec=0;tick();startTimer();document.getElementById('winOv').classList.remove('show');document.getElementById('histList').innerHTML='';updateDisplay();updateDealer();updateArrow();}

/* ═══ DISPLAY ═══ */
function updateDisplay(){[1,2].forEach(n=>{const el=document.getElementById('total'+n),v=scores[n-1],old=parseInt(el.textContent)||0;el.textContent=v;el.className='score-number'+(v>=WIN-20?' danger':'');if(v!==old){el.classList.add('pop');el.addEventListener('animationend',()=>el.classList.remove('pop'),{once:true});}});}
function renderHistory(){const c=document.getElementById('histList');c.innerHTML='';history.forEach((r,i)=>{const rn=history.length-i,d=document.createElement('div');d.className='history-row';const c1=r.add1>r.add2?'win':(r.add1===0?'z':''),c2=r.add2>r.add1?'win':(r.add2===0?'z':'');d.innerHTML='<div class="history-round">جولة '+rn+'</div><div class="history-val '+c1+'">'+r.add1+'</div><div class="history-sep"></div><div class="history-val '+c2+'">'+r.add2+'</div>';c.appendChild(d);});}

/* ═══ STATS ═══ */
function loadStats(){try{return JSON.parse(localStorage.getItem('nashrah_stats')||'null');}catch(e){return null;}}
function saveStats(s){try{localStorage.setItem('nashrah_stats',JSON.stringify(s));}catch(e){}}
function getStats(){return loadStats()||{team1:{wins:0,losses:0,games:0},team2:{wins:0,losses:0,games:0}};}
function recordWin(wi){const s=getStats(),wk=wi===0?'team1':'team2',lk=wi===0?'team2':'team1';s[wk].wins++;s[wk].games++;s[lk].losses++;s[lk].games++;saveStats(s);}
function switchTeam(idx){statsTeam=idx;document.getElementById('togT1').className='team-btn'+(idx===0?' active':'');document.getElementById('togT2').className='team-btn'+(idx===1?' active':'');renderStats();}
function renderStats(){
  const s=getStats(),key=statsTeam===0?'team1':'team2',d=s[key];
  const wins=d.wins||0,losses=d.losses||0,games=d.games||0,tot=Math.max(games,1);
  document.getElementById('togT1').textContent=getName(0)||'لنا';
  document.getElementById('togT2').textContent=getName(1)||'لهم';
  document.getElementById('statWins').textContent=wins;
  document.getElementById('statLoss').textContent=losses;
  document.getElementById('statGames').textContent=games;
  setTimeout(()=>{document.getElementById('barWins').style.width=(wins/tot*100)+'%';document.getElementById('barLoss').style.width=(losses/tot*100)+'%';document.getElementById('barGames').style.width='100%';},80);
  const wP=games>0?Math.round(wins/games*100):0,lP=games>0?Math.round(losses/games*100):0;
  document.getElementById('winPct').textContent=wP+'%';document.getElementById('lossPct').textContent=lP+'%';
  const lvl=wins*5+games*2;
  document.getElementById('levelNum').textContent=lvl;
  document.getElementById('levelRank').textContent=lvl>=200?'أسطورة':lvl>=100?'محترف':lvl>=50?'متقدم':lvl>=20?'متوسط':'مبتدئ';
  document.getElementById('levelArc').setAttribute('stroke-dashoffset',188.5-Math.min(lvl/300,1)*188.5);
}
function confirmResetStats(){document.getElementById('statsResetOv').classList.add('show');}
function doResetStats(){saveStats({team1:{wins:0,losses:0,games:0},team2:{wins:0,losses:0,games:0}});renderStats();document.getElementById('statsResetOv').classList.remove('show');}

/* ═══ THEMES ═══ */
const THEME_BGS = {
  1: { svg: `<g transform="rotate(-18 55 38)" opacity=".15"><rect x="15" y="8" width="38" height="54" rx="5" fill="white"/><text x="34" y="43" font-size="20" text-anchor="middle" font-family="serif" fill="#cc0000">&#9829;</text></g><g transform="rotate(14 255 28)" opacity=".15"><rect x="232" y="4" width="38" height="54" rx="5" fill="white"/><text x="251" y="39" font-size="20" text-anchor="middle" font-family="serif" fill="#111">&#9824;</text></g><g transform="rotate(-10 35 148)" opacity=".12"><rect x="10" y="122" width="38" height="54" rx="5" fill="white"/><text x="29" y="157" font-size="20" text-anchor="middle" font-family="serif" fill="#cc0000">&#9830;</text></g><g transform="rotate(20 265 148)" opacity=".12"><rect x="242" y="126" width="38" height="54" rx="5" fill="white"/><text x="261" y="161" font-size="20" text-anchor="middle" font-family="serif" fill="#111">&#9827;</text></g><text x="90" y="100" font-size="38" fill="rgba(255,255,255,.03)" font-family="serif">&#9829;</text><text x="190" y="95" font-size="38" fill="rgba(255,255,255,.03)" font-family="serif">&#9824;</text>` },
  2: { svg: `<ellipse cx="50%" cy="50%" rx="45%" ry="37%" fill="rgba(20,80,40,.5)" stroke="rgba(100,200,120,.1)" stroke-width="1.5"/><ellipse cx="50%" cy="50%" rx="40%" ry="31%" fill="rgba(15,65,32,.4)" stroke="rgba(100,200,120,.06)" stroke-width="1"/><text x="35%" y="44%" font-size="14" fill="rgba(255,255,255,.07)" text-anchor="middle" font-family="serif">&#9824;</text><text x="65%" y="44%" font-size="14" fill="rgba(255,255,255,.07)" text-anchor="middle" font-family="serif">&#9829;</text><text x="35%" y="62%" font-size="14" fill="rgba(255,255,255,.07)" text-anchor="middle" font-family="serif">&#9830;</text><text x="65%" y="62%" font-size="14" fill="rgba(255,255,255,.07)" text-anchor="middle" font-family="serif">&#9827;</text><circle cx="50%" cy="50%" r="10" fill="none" stroke="rgba(100,200,120,.14)" stroke-width="1"/><circle cx="50%" cy="50%" r="3" fill="rgba(100,200,120,.18)"/>` },
  3: { svg: `<text x="-10" y="75%" font-size="340" fill="rgba(99,179,255,.03)" font-family="serif">&#9824;</text><text x="30%" y="95%" font-size="300" fill="rgba(200,50,50,.04)" font-family="serif">&#9829;</text><text x="55%" y="70%" font-size="280" fill="rgba(99,179,255,.03)" font-family="serif">&#9827;</text>` },
  4: { svg: `<defs><pattern id="gcb" x="0" y="0" width="18" height="18" patternUnits="userSpaceOnUse"><polygon points="9,2 16,9 9,16 2,9" fill="none" stroke="rgba(99,179,255,.1)" stroke-width=".8"/><circle cx="9" cy="9" r="1.2" fill="rgba(99,179,255,.12)"/></pattern></defs><rect width="100%" height="100%" fill="url(#gcb)"/><rect x="8" y="8" width="calc(100% - 16px)" height="calc(100% - 16px)" rx="10" fill="none" stroke="rgba(99,179,255,.18)" stroke-width="1"/>` },
  5: { svg: `<defs><radialGradient id="gmj" cx="50%" cy="75%" r="55%"><stop offset="0%" stop-color="rgba(200,150,40,.12)"/><stop offset="100%" stop-color="transparent"/></radialGradient></defs><rect width="100%" height="100%" fill="url(#gmj)"/><g opacity=".2" fill="rgba(255,200,80,1)"><path d="M44,92% Q40,72% 43,60% Q45,52% 53,49% Q61,46% 63,50% Q65,46% 70,48% Q74,44% 79,50% L77,92% Z" transform="scale(1)"/></g><g opacity=".18"><g transform="rotate(-18 75% 18%)"><rect x="74%" y="6%" width="8%" height="22%" rx="4" fill="white"/><text x="78%" y="22%" font-size="14" text-anchor="middle" font-family="serif" fill="#cc0000">&#9829;</text></g><g transform="rotate(-5 75% 18%)"><rect x="76%" y="5%" width="8%" height="22%" rx="4" fill="white"/><text x="80%" y="21%" font-size="14" text-anchor="middle" font-family="serif" fill="#111">&#9824;</text></g><g transform="rotate(8 75% 18%)"><rect x="78%" y="6%" width="8%" height="22%" rx="4" fill="white"/><text x="82%" y="22%" font-size="14" text-anchor="middle" font-family="serif" fill="#cc0000">&#9830;</text></g></g><circle cx="7%" cy="11%" r="1.2" fill="rgba(255,255,255,.4)"/><circle cx="18%" cy="7%" r="1" fill="rgba(255,255,255,.32)"/><circle cx="40%" cy="10%" r="1.1" fill="rgba(255,255,255,.3)"/><circle cx="57%" cy="5%" r=".8" fill="rgba(255,255,255,.25)"/><line x1="0" y1="87%" x2="100%" y2="87%" stroke="rgba(255,200,80,.06)" stroke-width="1"/>` }
};

let currentTheme = 5;
function applyTheme(n) {
  currentTheme = n;
  document.querySelectorAll('.theme-item').forEach(t => t.classList.remove('sel'));
  const el = document.getElementById('th'+n);
  if(el) el.classList.add('sel');
  // apply background SVG to game screen orbs area
  const orb1 = document.querySelector('.orb1');
  const orb2 = document.querySelector('.orb2');
  // create/update theme svg layer
  let layer = document.getElementById('game-theme-layer');
  if(!layer){
    layer = document.createElementNS('http://www.w3.org/2000/svg','svg');
    layer.id = 'game-theme-layer';
    layer.setAttribute('viewBox','0 0 100 100');
    layer.setAttribute('preserveAspectRatio','xMidYMid slice');
    layer.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;';
    document.getElementById('game').insertBefore(layer, document.getElementById('game').firstChild);
  }
  layer.innerHTML = THEME_BGS[n].svg;
  try{localStorage.setItem('nashrah_theme',n);}catch(e){}
  setTimeout(()=>navTab('game'),180);
}
// load saved theme
try{const st=parseInt(localStorage.getItem('nashrah_theme')||'5');applyTheme(st);}catch(e){applyTheme(5);}

/* ═══ INIT ═══ */
applyNames('لنا','لهم');
</script>
</body>
</html>
